<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_purple">

    <!-- Map -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>


    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressBar"
            style="@style/Widget.AppCompat.ProgressBar"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:indeterminateTint="@android:color/white"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/loading_ride_information"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:layout_marginTop="16dp"/>
    </LinearLayout>

    <!-- Error Layout -->
    <LinearLayout
        android:id="@+id/layoutError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/danger"
            android:textSize="64sp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/unable_to_load_ride"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/failed_to_load_ride_information"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:alpha="0.9"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnErrorRefresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/try_again"
            android:textColor="@color/purple_600"
            android:backgroundTint="@android:color/white"
            android:paddingHorizontal="32dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/car_emoji"
            android:textSize="80sp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_active_ride"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/you_don_t_have_any_rides_in_progress_at_the_moment"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:alpha="0.9"
            android:gravity="center"/>
    </LinearLayout>

    <!-- Guest Notice -->
    <LinearLayout
        android:id="@+id/layoutGuestNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_guest_notice"
        android:padding="12dp"
        android:visibility="gone"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/man_emoji"
            android:textSize="20sp"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/you_are_viewing_this_ride_as_a_guest_via_email_invitation"
            android:textSize="13sp"
            android:textColor="@android:color/white"/>
    </LinearLayout>

    <!-- Content Sheet (anchored to bottom, max 350dp so map is always visible above) -->
    <LinearLayout
        android:id="@+id/layoutContent"
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:visibility="gone">

        <ScrollView
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="false"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_bottom_sheet"
                android:padding="20dp"
                android:elevation="16dp">

                <!-- Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/track_your_ride"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/gray_900"/>

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/in_progress"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/bg_status_in_progress"
                        android:textColor="@color/status_in_progress_text"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>

                <!-- Refresh Button -->
                <Button
                    android:id="@+id/btnRefresh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/refresh"
                    android:textColor="@color/purple_600"
                    android:backgroundTint="@android:color/white"
                    android:elevation="4dp"
                    android:layout_marginBottom="16dp"/>

                <!-- Driver Info Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardDriverInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/driver_information"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/gray_900"
                            android:layout_marginBottom="12dp"/>

                        <!-- Driver Name -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="6dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/driver"
                                android:textSize="14sp"
                                android:textColor="@color/gray_600"/>

                            <TextView
                                android:id="@+id/tvDriverName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/loading"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/gray_900"/>
                        </LinearLayout>

                        <!-- Driver Phone -->
                        <LinearLayout
                            android:id="@+id/layoutDriverPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="6dp"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/phone_w"
                                android:textSize="14sp"
                                android:textColor="@color/gray_600"/>

                            <TextView
                                android:id="@+id/tvDriverPhone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/_1234567890"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/gray_900"/>
                        </LinearLayout>

                        <!-- Vehicle Model -->
                        <LinearLayout
                            android:id="@+id/layoutVehicleModel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="6dp"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/vehicle_w"
                                android:textSize="14sp"
                                android:textColor="@color/gray_600"/>

                            <TextView
                                android:id="@+id/tvVehicleModel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/toyota_camry"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/gray_900"/>
                        </LinearLayout>

                        <!-- Vehicle Registration -->
                        <LinearLayout
                            android:id="@+id/layoutVehicleReg"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="6dp"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/registration_w"
                                android:textSize="14sp"
                                android:textColor="@color/gray_600"/>

                            <TextView
                                android:id="@+id/tvVehicleRegistration"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/abc_1234"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/gray_900"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Time Remaining Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardTimeRemaining"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/time_remaining"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/gray_900"
                            android:layout_marginBottom="12dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvTimeIcon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/clock_emoji"
                                android:textSize="24sp"
                                android:layout_marginEnd="12dp"/>

                            <TextView
                                android:id="@+id/tvTimeRemaining"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/_15_min"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="@color/orange_700"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Route Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardRoute"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/route"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/gray_900"
                            android:layout_marginBottom="12dp"/>

                        <LinearLayout
                            android:id="@+id/layoutRoutePoints"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Action Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btnReport"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="@string/report_emoji"
                        android:textSize="15sp"
                        android:layout_marginEnd="8dp"
                        app:strokeColor="@color/purple_600"
                        android:textColor="@color/purple_600"/>

                    <Button
                        android:id="@+id/btnPanic"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="@string/panic_emoji"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/red_600"
                        android:textColor="@android:color/white"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>