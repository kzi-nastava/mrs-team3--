<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRide"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header: Date and Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvRideDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Jan 15, 2024 10:30"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#6B7280"/>

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COMPLETED"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:background="@drawable/rounded_badge"
                android:textAllCaps="true"
                android:letterSpacing="0.05"/>

        </LinearLayout>

        <!-- Route Information -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <!-- Start Location -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <View
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/circle_start"/>

                <TextView
                    android:id="@+id/tvStartAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/start_address"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#111827"
                    android:maxLines="2"
                    android:ellipsize="end"/>

            </LinearLayout>

            <!-- Stops (optional) -->
            <TextView
                android:id="@+id/tvStops"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stops"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#6B7280"
                android:layout_marginStart="32dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                android:maxLines="2"
                android:ellipsize="end"/>

            <!-- End Location -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <View
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/circle_end"/>

                <TextView
                    android:id="@+id/tvEndAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/end_address"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#111827"
                    android:maxLines="2"
                    android:ellipsize="end"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Admin Info (driver + passengers + flags) -->
        <LinearLayout
            android:id="@+id/adminInfoContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvDriverName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Driver: Petar Petrovic"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvPassengers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Passengers: a@mail.com, b@mail.com"
                android:textSize="12sp"
                android:textColor="#6B7280"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="4dp"/>

            <!-- Panic badge (optional) -->
            <TextView
                android:id="@+id/tvPanicBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/is_panic"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/rounded_badge"
                android:textAllCaps="true"
                android:letterSpacing="0.05"
                android:visibility="gone"/>

            <!-- Cancellation reason (optional) -->
            <TextView
                android:id="@+id/tvCancellationReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cancellation"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#991B1B"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                android:maxLines="2"
                android:ellipsize="end"/>

            <!-- Reviews (optional) -->
            <LinearLayout
                android:id="@+id/reviewsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvDriverReview"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Driver ⭐ 4.8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#111827"/>

                <TextView
                    android:id="@+id/tvRideReview"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ride ⭐ 4.5"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#111827"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F3F4F6"
            android:layout_marginBottom="16dp"/>

        <!-- Ride Info (same pattern as driver item) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Price -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/price"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#6B7280"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1250 din"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#059669"/>
            </LinearLayout>

            <!-- Start time -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/start_time"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#6B7280"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvStartTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10:30"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#111827"/>
            </LinearLayout>

            <!-- End time -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/end_time"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#6B7280"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvEndTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10:55"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#111827"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Inconsistency reports indicator (optional) -->
        <TextView
            android:id="@+id/tvInconsistency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/inconsistencies_reported"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#B45309"
            android:layout_marginTop="12dp"
            android:visibility="gone"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
