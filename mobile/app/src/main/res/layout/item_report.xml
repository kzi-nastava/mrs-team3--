<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="8dp"
    app:cardBackgroundColor="#FEF2F2"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvReportDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/jan_15_2024_10_30"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#991B1B"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvReportMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/route_deviation_reported_by_passenger"
            android:textSize="14sp"
            android:textColor="#7F1D1D"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>