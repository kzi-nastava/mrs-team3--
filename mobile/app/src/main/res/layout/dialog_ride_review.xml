<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/review_your_ride"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvRideInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/driver_john_doe_feb_15_2026"
            android:textSize="14sp"
            android:textColor="#6B7280"
            android:layout_marginBottom="24dp"/>

        <!-- Deadline Warning (if applicable) -->
        <LinearLayout
            android:id="@+id/layoutDeadlineWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#FEF3C7"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/timer_clock_emoji"
                android:textSize="20sp"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tvDeadlineWarning"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/_2_days_remaining_to_review"
                android:textSize="14sp"
                android:textColor="#92400E"/>

        </LinearLayout>

        <!-- Existing Review Notice -->
        <LinearLayout
            android:id="@+id/layoutExistingReview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#E0E7FF"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/review_emoji"
                android:textSize="20sp"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tvExistingReview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/you_already_reviewed_this_ride"
                android:textSize="14sp"
                android:textColor="#3730A3"/>

        </LinearLayout>

        <!-- Driver Rating -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rate_the_driver"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#374151"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:id="@+id/layoutDriverStars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvDriverStar1"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="@string/star_emoji"
                android:textSize="32sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <TextView
                android:id="@+id/tvDriverStar2"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="@string/star_emoji"
                android:textSize="32sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <TextView
                android:id="@+id/tvDriverStar3"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="@string/star_emoji"
                android:textSize="32sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <TextView
                android:id="@+id/tvDriverStar4"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="@string/star_emoji"
                android:textSize="32sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <TextView
                android:id="@+id/tvDriverStar5"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="@string/star_emoji"
                android:textSize="32sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tvDriverRatingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tap_to_rate"
            android:textSize="14sp"
            android:textColor="#9CA3AF"
            android:layout_marginBottom="24dp"/>

        <!-- Vehicle Rating -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rate_the_vehicle"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#374151"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:id="@+id/layoutVehicleStars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvVehicleStar1"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="@string/star_emoji"
                android:textSize="32sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <TextView
                android:id="@+id/tvVehicleStar2"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="@string/star_emoji"
                android:textSize="32sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <TextView
                android:id="@+id/tvVehicleStar3"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="@string/star_emoji"
                android:textSize="32sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <TextView
                android:id="@+id/tvVehicleStar4"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="@string/star_emoji"
                android:textSize="32sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <TextView
                android:id="@+id/tvVehicleStar5"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="@string/star_emoji"
                android:textSize="32sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tvVehicleRatingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tap_to_rate"
            android:textSize="14sp"
            android:textColor="#9CA3AF"
            android:layout_marginBottom="24dp"/>

        <!-- Comment -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/additional_comments_optional"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#374151"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etComment"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:gravity="top|start"
            android:hint="@string/share_your_experience"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="1000"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvCharCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/_0_1000"
            android:textSize="12sp"
            android:textColor="#9CA3AF"
            android:layout_gravity="end"
            android:layout_marginBottom="24dp"/>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel"
                android:textSize="14sp"
                android:backgroundTint="#9CA3AF"
                android:textColor="@android:color/white"
                android:layout_marginEnd="8dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"/>

            <Button
                android:id="@+id/btnSubmit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/submit_review"
                android:textSize="14sp"
                android:backgroundTint="#6366f1"
                android:textColor="@android:color/white"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"/>

        </LinearLayout>

        <!-- Loading Indicator -->
        <ProgressBar
            android:id="@+id/pbLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone"/>

    </LinearLayout>

</ScrollView>