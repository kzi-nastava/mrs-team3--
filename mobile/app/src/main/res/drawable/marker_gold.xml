<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow -->
    <item android:top="2dp">
        <shape android:shape="oval">
            <solid android:color="#40000000"/>
            <size
                android:width="32dp"
                android:height="32dp"/>
        </shape>
    </item>
    <!-- Main circle -->
    <item android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="@color/route_stop_reached"/>
            <size
                android:width="32dp"
                android:height="32dp"/>
        </shape>
    </item>
    <!-- Inner white circle -->
    <item
        android:bottom="8dp"
        android:left="6dp"
        android:right="6dp"
        android:top="6dp">
        <shape android:shape="oval">
            <solid android:color="@android:color/white"/>
        </shape>
    </item>
</layer-list>